---
import Header from '@info-evry/astro-design/components/Header.astro';
import associationInfo from '@info-evry/knowledge/association';

const assoUrl = associationInfo.sites.asso.url;

const navLinks = [
  { href: `${assoUrl}/#a-propos`, label: 'À propos' },
  { href: `${assoUrl}/#ressources`, label: 'Ressources' },
  { href: `${assoUrl}/#ndi`, label: 'Nuit de l\'Info' },
];
---

<Header
  homeUrl={assoUrl}
  navLinks={navLinks}
  ctaHref="#inscription"
  ctaLabel="Adhérer"
  mobileCta="Adhérer à l'association"
/>
